# Copy to .env (git-ignored) before `docker compose up`. All values are safe local defaults.
# Reference: docs/BLUEPRINT.md §5.10

# --- Server ---
PORT=3000
LOG_LEVEL=info

# --- Product source (Fake Store) ---
PRODUCT_API_BASE_URL=https://fakestoreapi.com
PRODUCT_API_TIMEOUT_MS=5000
PRODUCT_CACHE_TTL_SECONDS=300
# Oldest cached copy served when a refetch fails (24 h).
PRODUCT_STALE_MAX_AGE_SECONDS=86400
# After a failed refresh, serve the stale copy without calling upstream for this long.
CACHE_RETRY_BACKOFF_SECONDS=30

# --- Image proxy ---
# Comma-separated hostnames the backend may fetch product images from.
IMAGE_HOST_ALLOWLIST=fakestoreapi.com
IMAGE_TIMEOUT_MS=5000
IMAGE_CACHE_MAX_ENTRIES=100
IMAGE_MAX_BYTES=5242880
IMAGE_CLIENT_MAX_AGE_SECONDS=86400

# --- Home: featured products (ordered; missing ids skipped, filled by rating to 5) ---
FEATURED_PRODUCT_IDS=12,11,3,18,5

# --- Email (Mailpit locally; use SMTP_HOST=localhost when running the API outside Docker) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Connection, greeting and socket timeout; a hung mail server gives 502 instead of a minutes-long wait.
SMTP_TIMEOUT_MS=10000
# Amazon SES: SMTP_HOST=email-smtp.<region>.amazonaws.com with SES SMTP credentials, and either
# SMTP_PORT=587 + SMTP_SECURE=false (STARTTLS) or SMTP_PORT=465 + SMTP_SECURE=true.
MAIL_FROM=catalogue@example.com
SALES_INBOX_EMAIL=sales@example.com

# --- HTTP ---
JSON_BODY_LIMIT=10kb
